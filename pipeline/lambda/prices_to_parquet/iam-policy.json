{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadRawPrices",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::<BUCKET>/raw/prices/*"
    },
    {
      "Sid": "WriteCuratedPrices",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<BUCKET>/curated/prices/*"
    },
    {
      "Sid": "ListBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<BUCKET>"
    }
  ]
}
